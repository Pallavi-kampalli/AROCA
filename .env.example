# TraceIQ Environment Configuration
# Copy this file to .env and fill in your values

# ── PostgreSQL ──────────────────────────────────────
POSTGRES_USER=traceiq
POSTGRES_PASSWORD=traceiq_secret
POSTGRES_DB=traceiq

# ── Application ─────────────────────────────────────
SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── LLM Provider (Ollama - local, free) ─────────────
LLM_PROVIDER=ollama
# For Docker: use host.docker.internal to reach your local Ollama
LLM_BASE_URL=http://host.docker.internal:11434/v1
# For running backend locally (not Docker): use localhost
# LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2
# Ollama does not require a real API key but the field must be set
LLM_API_KEY=ollama
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=2048

# ── File Storage ─────────────────────────────────────
UPLOAD_DIR=./uploads
ML_MODELS_DIR=./ml_models
MAX_UPLOAD_SIZE_MB=50

# ── OpenAI-compatible alternative (optional) ─────────
# Uncomment and fill these if you want to use OpenAI instead of Ollama
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o
# LLM_API_KEY=sk-...
